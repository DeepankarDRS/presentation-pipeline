# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for live (non --dry-run) generation.
OPENAI_API_KEY=sk-your-key-here

# Model + sampling. Chat Completions API only (client.chat.completions.create).
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2000
# Optional: override the API base (e.g. Azure / proxy). Leave this line
# commented out for normal OpenAI use — an empty value breaks the SDK.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Path to the Node.js executable. Leave as "node" if it is on PATH.
NODE_BIN=node

# Retry budget for a failed compile (diagnostics fed back to the LLM).
RETRY_BUDGET=1

# LangSmith tracing. Set LANGSMITH_TRACING=true to enable. Leave
# LANGSMITH_ENDPOINT blank for the default (https://api.smith.langchain.com).
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=test
