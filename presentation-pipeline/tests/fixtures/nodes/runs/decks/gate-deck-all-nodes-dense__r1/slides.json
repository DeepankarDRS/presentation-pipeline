  "xml": "<Slide>\n  <VStack w=\"1280\" h=\"720\" padding=\"36\" gap=\"16\" alignItems=\"stretch\" backgroundColor=\"$surface\">\n    <HStack justifyContent=\"spaceBetween\" alignItems=\"start\">\n      <VStack gap=\"4\">\n        <Text fontSize=\"14\" color=\"$accent\" bold=\"true\" letterSpacing=\"2\">PERFORMANCE</Text>\n        <Text fontSize=\"30\" color=\"$textMain\" bold=\"true\"><Span color=\"$accent\">Repeat customers</Span> now drive most of BREWLY's revenue.</Text>\n        <Text fontSize=\"14\" color=\"$textMuted\">Annual revenue: ₹14.2Cr · Revenue growth: +38% · Blended ROAS: 2.4x</Text>\n      </VStack>\n    </HStack>\n    <HStack gap=\"14\" alignItems=\"stretch\">\n      <VStack w=\"max\" padding=\"16\" gap=\"6\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"14\" color=\"$textMuted\">Annual revenue</Text>\n        <Text fontSize=\"28\" bold=\"true\" color=\"$textMain\">₹14.2<Span fontSize=\"16\" color=\"$textMuted\">Cr</Span></Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"16\" gap=\"6\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" borderLeft.color=\"$positive\" borderLeft.width=\"4\" justifyContent=\"center\">\n        <Text fontSize=\"14\" color=\"$textMuted\">Revenue growth</Text>\n        <Text fontSize=\"28\" bold=\"true\" color=\"$positive\">+38%</Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"16\" gap=\"6\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"14\" color=\"$textMuted\">Blended ROAS</Text>\n        <Text fontSize=\"28\" bold=\"true\" color=\"$textMain\">2.4<Span fontSize=\"16\" color=\"$textMuted\">x</Span></Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"16\" gap=\"6\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" opacity=\"0.6\" justifyContent=\"center\">\n        <Text fontSize=\"14\" color=\"$textMuted\">Customer acquisition cost</Text>\n        <Text fontSize=\"28\" bold=\"true\" color=\"$textMuted\">₹410</Text>\n      </VStack>\n    </HStack>\n    <HStack grow=\"2\" gap=\"16\" alignItems=\"stretch\">\n      <VStack w=\"60%\" grow=\"1\" padding=\"24\" gap=\"10\" backgroundColor=\"$surfaceAlt\" borderRadius=\"16\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"14\" color=\"$textMuted\" bold=\"true\" letterSpacing=\"1\">REPEAT REVENUE SHARE</Text>\n        <Text fontSize=\"64\" color=\"$positive\" bold=\"true\">62<Span fontSize=\"32\" color=\"$textMuted\">%</Span></Text>\n        <Text fontSize=\"16\" color=\"$positive\" bold=\"true\" lineHeight=\"1.45\">up from 41% a year ago</Text>\n      </VStack>\n      <VStack w=\"40%\" padding=\"18\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\">\n        <Text fontSize=\"14\" bold=\"true\" color=\"$textMain\">Quarterly revenue (₹ Cr)</Text>\n        <Chart h=\"max\" minH=\"180\" chartType=\"bar\" showLegend=\"false\" chartColors='[\"B6CCF7\",\"B6CCF7\",\"B6CCF7\",\"B6CCF7\",\"B6CCF7\",\"2563EB\"]'>\n          <ChartSeries name=\"Revenue\">\n            <ChartDataPoint label=\"Q1 FY26\" value=\"2.6\" />\n            <ChartDataPoint label=\"Q2 FY26\" value=\"2.9\" />\n            <ChartDataPoint label=\"Q3 FY26\" value=\"3.3\" />\n            <ChartDataPoint label=\"Q4 FY26\" value=\"3.6\" />\n            <ChartDataPoint label=\"Q1 FY27\" value=\"3.9\" />\n            <ChartDataPoint label=\"Q2 FY27\" value=\"4.4\" />\n          </ChartSeries>\n        </Chart>\n      </VStack>\n    </HStack>\n    <VStack padding=\"14\" gap=\"4\" backgroundColor=\"$surfaceAlt\" borderRadius=\"10\" border.color=\"$border\" border.width=\"1\" shadow.blur=\"6\" shadow.offset=\"2\" shadow.color=\"000\">\n      <Text fontSize=\"14\" color=\"$textMain\" lineHeight=\"1.45\">Growth came from <Span color=\"$positive\">retention and pricing</Span>, not from buying more traffic.</Text>\n    </VStack>\n  </VStack>\n</Slide>\n",
