  "xml": "<Slide>\n  <VStack w=\"1280\" h=\"720\" padding=\"36\" gap=\"18\" alignItems=\"stretch\" backgroundColor=\"$surface\">\n    <HStack justifyContent=\"spaceBetween\" alignItems=\"start\">\n      <VStack gap=\"4\">\n        <Text fontSize=\"14\" color=\"$accent\" bold=\"true\" letterSpacing=\"2\">CHANNELS</Text>\n        <Text fontSize=\"29\" color=\"$textMain\" bold=\"true\">The website earns the best margin; bundles and referrals are the quick wins.</Text>\n        <Text fontSize=\"14\" color=\"$textMuted\">Website: <Span color=\"$positive\">₹7.1Cr</Span> · QUIKMART: ₹4.3Cr · DASHCART: ₹2.8Cr</Text>\n      </VStack>\n    </HStack>\n    <VStack padding=\"20\" gap=\"10\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" shadow.blur=\"6\" shadow.offset=\"2\" shadow.color=\"000\">\n      <Text fontSize=\"16\" bold=\"true\" color=\"$textMain\">Channel-level economics</Text>\n      <Table defaultRowHeight=\"50\" cellBorder.color=\"$border\" cellBorder.width=\"1\">\n        <Col width=\"180\" />\n        <Col />\n        <Col />\n        <Col />\n        <Tr height=\"40\">\n          <Td bold=\"true\" backgroundColor=\"$surfaceAlt\" color=\"$textMain\" fontSize=\"14\">Channel</Td>\n          <Td bold=\"true\" backgroundColor=\"$surfaceAlt\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">Revenue</Td>\n          <Td bold=\"true\" backgroundColor=\"$surfaceAlt\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">ROAS</Td>\n          <Td bold=\"true\" backgroundColor=\"$surfaceAlt\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">Gross Margin</Td>\n        </Tr>\n        <Tr>\n          <Td backgroundColor=\"E6F4EA\" color=\"$textMain\" fontSize=\"14\" bold=\"true\">Website</Td>\n          <Td backgroundColor=\"E6F4EA\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">₹7.1Cr</Td>\n          <Td backgroundColor=\"E6F4EA\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">3.1x</Td>\n          <Td backgroundColor=\"E6F4EA\" color=\"$positive\" fontSize=\"14\" textAlign=\"right\" bold=\"true\">64%</Td>\n        </Tr>\n        <Tr>\n          <Td backgroundColor=\"$surface\" color=\"$textMuted\" fontSize=\"14\">QUIKMART</Td>\n          <Td backgroundColor=\"$surface\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">₹4.3Cr</Td>\n          <Td backgroundColor=\"$surface\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">2.2x</Td>\n          <Td backgroundColor=\"$surface\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">55%</Td>\n        </Tr>\n        <Tr>\n          <Td backgroundColor=\"$surface\" color=\"$textMuted\" fontSize=\"14\">DASHCART</Td>\n          <Td backgroundColor=\"$surface\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">₹2.8Cr</Td>\n          <Td backgroundColor=\"$surface\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">1.4x</Td>\n          <Td backgroundColor=\"$surface\" color=\"$textMain\" fontSize=\"14\" textAlign=\"right\">47%</Td>\n        </Tr>\n      </Table>\n    </VStack>\n    <HStack gap=\"18\" alignItems=\"stretch\">\n      <VStack w=\"max\">\n        <VStack padding=\"18\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" borderLeft.color=\"$positive\" borderLeft.width=\"4\" border.color=\"$border\" border.width=\"1\" shadow.blur=\"6\" shadow.offset=\"2\" shadow.color=\"000\">\n          <Text fontSize=\"15\" bold=\"true\" color=\"$textMain\">Brand priorities</Text>\n          <Pyramid direction=\"up\" h=\"228\" fontSize=\"15\" bold=\"true\">\n            <PyramidLevel label=\"Category leadership\" color=\"15803D\" textColor=\"FFFFFF\" />\n            <PyramidLevel label=\"Loyal subscribers\" color=\"2563EB\" textColor=\"FFFFFF\" />\n            <PyramidLevel label=\"Consistent experience\" color=\"3B82F6\" textColor=\"FFFFFF\" />\n            <PyramidLevel label=\"Fresh roast quality\" color=\"1D4ED8\" textColor=\"FFFFFF\" />\n          </Pyramid>\n        </VStack>\n      </VStack>\n      <VStack w=\"max\">\n        <VStack padding=\"18\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" borderLeft.color=\"$accent\" borderLeft.width=\"4\" border.color=\"$border\" border.width=\"1\" shadow.blur=\"6\" shadow.offset=\"2\" shadow.color=\"000\">\n          <HStack justifyContent=\"spaceBetween\" alignItems=\"center\">\n            <Text fontSize=\"15\" bold=\"true\" color=\"$textMain\">Activation ideas: Effort vs Impact</Text>\n            <Text fontSize=\"14\" color=\"$textMuted\">2x2 matrix</Text>\n          </HStack>\n          <Matrix h=\"max\" minH=\"260\" axisLabelColor=\"$textMuted\" quadrantLabelColor=\"$textMuted\" itemLabelColor=\"$textMain\">\n            <MatrixAxes x=\"Effort\" y=\"Impact\" />\n            <MatrixQuadrants topLeft=\"Quick wins (low effort, high impact)\" topRight=\"Strategic bets (high effort, high impact)\" bottomLeft=\"Low priority (low effort, low impact)\" bottomRight=\"Avoid / deprioritise (high effort, low impact)\" />\n            <MatrixItem label=\"Bundle offers\" x=\"0.18\" y=\"0.85\" color=\"$positive\" />\n            <MatrixItem label=\"Referral program\" x=\"0.32\" y=\"0.78\" color=\"$positive\" />\n            <MatrixItem label=\"Own delivery fleet\" x=\"0.82\" y=\"0.82\" color=\"2563EB\" />\n            <MatrixItem label=\"Loyalty app\" x=\"0.82\" y=\"0.18\" color=\"$warning\" />\n          </Matrix>\n        </VStack>\n      </VStack>\n    </HStack>\n  </VStack>\n</Slide>\n",
