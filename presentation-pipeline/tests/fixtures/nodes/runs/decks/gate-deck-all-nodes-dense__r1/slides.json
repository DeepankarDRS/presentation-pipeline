" gap=\"8\" backgroundColor=\"$textMain\" borderRadius=\"14\" justifyContent=\"center\">\n          <Icon name=\"lightbulb\" size=\"24\" color=\"$accent\" alignSelf=\"start\" />\n          <Text fontSize=\"18\" color=\"$surfaceAlt\" bold=\"true\">Content</Text>\n          <Text fontSize=\"14\" color=\"$surfaceAlt\" lineHeight=\"1.45\">build the community</Text>\n        </VStack>\n      </HStack>\n    </VStack>\n    <HStack grow=\"1\" gap=\"10\" alignItems=\"stretch\">\n      <VStack w=\"max\" padding=\"18\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\">\n        <Text fontSize=\"14\" color=\"$textMuted\" bold=\"true\" letterSpacing=\"1\">Month 1 Audit</Text>\n        <Text fontSize=\"18\" color=\"$textMain\" bold=\"true\">Audit</Text>\n        <Text fontSize=\"14\" color=\"$textMain\" lineHeight=\"1.45\">channel economics review, offer audit</Text>\n      </VStack>\n      <Icon name=\"arrow-right\" size=\"20\" color=\"$textMuted\" alignSelf=\"center\" />\n      <VStack w=\"max\" padding=\"18\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\">\n        <Text fontSize=\"14\" color=\"$textMuted\" bold=\"true\" letterSpacing=\"1\">Month 2 Activate</Text>\n        <Text fontSize=\"18\" color=\"$textMain\" bold=\"true\">Activate</Text>\n        <Text fontSize=\"14\" color=\"$textMain\" lineHeight=\"1.45\">launch bundles, start referral pilot</Text>\n      </VStack>\n      <Icon name=\"arrow-right\" size=\"20\" color=\"$textMuted\" alignSelf=\"center\" />\n      <VStack w=\"max\" padding=\"18\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderLeft.color=\"$accent\" borderLeft.width=\"4\" borderRadius=\"14\">\n        <Text fontSize=\"14\" color=\"$accent\" bold=\"true\" letterSpacing=\"1\">Month 3 Scale</Text>\n        <Text fontSize=\"18\" color=\"$textMain\" bold=\"true\">Scale</Text>\n        <Text fontSize=\"14\" color=\"$textMain\" lineHeight=\"1.45\">shift budget to winning channels, expand subscriptions</Text>\n      </VStack>\n    </HStack>\n  </VStack>\n</Slide>\n",
