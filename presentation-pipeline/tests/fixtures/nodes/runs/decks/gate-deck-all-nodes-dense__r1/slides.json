extMain\" bold=\"true\">Conversion decision flow</Text>\n        </HStack>\n        <Flow direction=\"horizontal\" h=\"max\" minH=\"200\" nodeWidth=\"170\" nodeHeight=\"56\" nodeGap=\"54\">\n          <FlowNode id=\"v1\" shape=\"flowChartTerminator\" text=\"Visitor lands\" color=\"2563EB\" textColor=\"FFFFFF\" />\n          <FlowNode id=\"v2\" shape=\"flowChartDecision\" text=\"Bought before?\" color=\"$accent\" textColor=\"FFFFFF\" />\n          <FlowNode id=\"v3a\" shape=\"flowChartProcess\" text=\"Yes: Subscription offer\" color=\"15803D\" textColor=\"FFFFFF\" />\n          <FlowNode id=\"v3b\" shape=\"flowChartProcess\" text=\"No: Trial pack\" color=\"2563EB\" textColor=\"FFFFFF\" />\n          <FlowNode id=\"v4\" shape=\"flowChartTerminator\" text=\"Checkout\" color=\"0EA5E9\" textColor=\"FFFFFF\" />\n          <FlowConnection from=\"v1\" to=\"v2\" />\n          <FlowConnection from=\"v2\" to=\"v3a\" label=\"Yes\" color=\"15803D\" labelColor=\"15803D\" />\n          <FlowConnection from=\"v2\" to=\"v3b\" label=\"No\" color=\"$accent\" labelColor=\"$accent\" />\n          <FlowConnection from=\"v3a\" to=\"v4\" />\n          <FlowConnection from=\"v3b\" to=\"v4\" />\n        </Flow>\n      </VStack>\n      <VStack w=\"max\" padding=\"18\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" borderLeft.color=\"$accent\" borderLeft.width=\"4\" justifyContent=\"center\">\n        <HStack gap=\"8\" alignItems=\"center\">\n          <Icon name=\"settings\" size=\"20\" color=\"$accent\" />\n          <Text fontSize=\"14\" color=\"$textMain\" bold=\"true\">Conversion rules</Text>\n        </HStack>\n        <Ul fontSize=\"15\" color=\"$textMain\" lineHeight=\"1.4\">\n          <Li bold=\"true\">Returning buyers never see the trial pack</Li>\n          <Li>First-time visitors get one offer</Li>\n          <Li>Every offer ends at one checkout</Li>\n        </Ul>\n      </VStack>\n    </HStack>\n  </VStack>\n</Slide>\n",
