 "deck-qbr-data-s1-r1": "<Slide>\n  <VStack w=\"1280\" h=\"720\" padding=\"48\" gap=\"28\" alignItems=\"stretch\" backgroundColor=\"$surface\">\n    <VStack gap=\"8\">\n      <Text fontSize=\"14\" color=\"$accentText\" bold=\"true\" letterSpacing=\"2\">EXECUTIVE SUMMARY</Text>\n      <Text fontSize=\"36\" color=\"$textMain\" bold=\"true\" lineHeight=\"1.15\"><Span color=\"$accent\">ARR</Span> grew to $48.2M while margin softened</Text>\n      <Text fontSize=\"18\" color=\"$textMuted\">Q3 FY26 vs Q2 FY26</Text>\n    </VStack>\n    <VStack gap=\"18\" grow=\"1\"><HStack gap=\"18\" alignItems=\"stretch\" grow=\"1\"><VStack padding=\"20\" gap=\"8\" backgroundColor=\"$accentSoft\" borderRadius=\"16\" border.color=\"$border\" border.width=\"1\" shadow.type=\"outer\" shadow.blur=\"6\" shadow.offset=\"2\" shadow.color=\"000\" justifyContent=\"center\" w=\"49%\">\n        <HStack gap=\"8\" alignItems=\"center\">\n          <Icon name=\"dollar-sign\" size=\"24\" color=\"$accent\"/>\n          <Text fontSize=\"14\" color=\"$accentText\" bold=\"true\">ARR</Text>\n        </HStack>\n        <Text fontSize=\"28\" color=\"$accentText\" bold=\"true\" id=\"kpiv-kpi_metrics-0\">$48.2<Span fontSize=\"14\">M</Span></Text>\n        <Text fontSize=\"16\" color=\"$positiveText\" bold=\"true\">+18% QoQ</Text>\n      </VStack>\n      <VStack padding=\"16\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\" w=\"49%\">\n        <HStack gap=\"8\" alignItems=\"center\">\n          <Icon name=\"percent\" size=\"22\" color=\"$positive\"/>\n          <Text fontSize=\"14\" color=\"$positiveText\" bold=\"true\">NRR</Text>\n        </HStack>\n        <Text fontSize=\"28\" color=\"$positiveText\" bold=\"true\" id=\"kpiv-kpi_metrics-1\">114<Span fontSize=\"14\">%</Span></Text>\n        <Text fontSize=\"16\" color=\"$positiveText\" bold=\"true\">+2 pts</Text>\n      </VStack>\n      </HStack><HStack gap=\"18\" alignItems=\"s