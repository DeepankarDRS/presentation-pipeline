 "deck-qbr-data-s1-r2": "<Slide>\n  <VStack w=\"1280\" h=\"720\" padding=\"48\" gap=\"28\" alignItems=\"stretch\" backgroundColor=\"$surface\">\n    <VStack gap=\"8\" alignItems=\"start\">\n      <Text fontSize=\"14\" color=\"$accentText\" bold=\"true\" letterSpacing=\"2\">EXECUTIVE SUMMARY</Text>\n      <Text fontSize=\"36\" color=\"$textMain\" bold=\"true\" lineHeight=\"1.15\"><Span color=\"$accent\">ARR</Span> grew to $48.2M while margin softened</Text>\n      <Text fontSize=\"18\" color=\"$textMuted\">Q3 FY26 vs Q2 FY26</Text>\n    </VStack>\n    <VStack gap=\"18\" grow=\"1\">\n      <HStack gap=\"18\" alignItems=\"stretch\" grow=\"1\">\n        <VStack padding=\"24\" gap=\"8\" backgroundColor=\"$accentSoft\" borderRadius=\"16\" border.color=\"$border\" border.width=\"1\" shadow.type=\"outer\" shadow.blur=\"6\" shadow.offset=\"2\" shadow.color=\"000\" justifyContent=\"center\" w=\"49%\">\n          <HStack gap=\"8\" alignItems=\"center\">\n            <Icon name=\"dollar-sign\" size=\"24\" color=\"$accent\"/>\n            <Text fontSize=\"16\" color=\"$accentText\" bold=\"true\">ARR</Text>\n          </HStack>\n          <Text fontSize=\"28\" bold=\"true\" color=\"$accentText\" id=\"kpiv-kpi_metrics-0\">$48.2<Span fontSize=\"14\">M</Span></Text>\n          <Text fontSize=\"16\" bold=\"true\" color=\"$positiveText\">+18% QoQ</Text>\n        </VStack>\n        <VStack padding=\"20\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\" w=\"49%\">\n          <HStack gap=\"8\" alignItems=\"center\">\n            <Icon name=\"percent\" size=\"22\" color=\"$positive\"/>\n            <Text fontSize=\"16\" color=\"$accentText\" bold=\"true\">NRR</Text>\n          </HStack>\n          <Text fontSize=\"28\" bold=\"true\" color=\"$positiveText\" id=\"kpiv-kpi_metrics-1\">114<Span fontSize=\"14\">%</Span></Text>\n          <Text fontSize=\"16\" bold=\"true\" color=\"$positiveText\">+2 pts</Text>\n        </VStack>\n      </HStack>\n      <HStack gap=\"18\" alignItems=\"stretch\" grow=\"1\">\n        <VStack padding=\"20\" gap=\"8\" backgroundColor=\"$negativeSoft\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\" w=\"49%\">\n          <HStack gap=\"8\" alignItems=\"center\">\n            <Icon name=\"percent\" size=\"22\" color=\"$negative\"/>\n            <Text fontSize=\"16\" color=\"$accentText\" bold=\"true\">Gross Margin</Text>\n          </HStack>\n          <Text fontSize=\"28\" bold=\"true\" color=\"$negativeText\" id=\"kpiv-kpi_metrics-2\">72.1<Span fontSize=\"14\">%</Span></Text>\n          <Text fontSize=\"16\" bold=\"true\" color=\"$negativeText\">-1.4 pts</Text>\n        </VStack>\n        <VStack padding=\"20\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\" w=\"49%\">\n          <HStack gap=\"8\" alignItems=\"center\">\n            <Icon name=\"clock\" size=\"22\" color=\"$accent\"/>\n            <Text fontSize=\"16\" color=\"$accentText\" bold=\"true\">CAC Payback</Text>\n          </HStack>\n          <Text fontSize=\"28\" bold=\"true\" color=\"$textMain\" id=\"kpiv-kpi_metrics-3\">14<Span fontSize=\"14\"> months</Span></Text>\n          <Text fontSize=\"16\" bold=\"true\" color=\"$positiveText\">-2 months</Text>\n        </VStack>\n      </HStack>\n    </VStack>\n  </VStack>\n</Slide>\n",
 "deck-qbr-data-s1-r3": "<Slide>\n  <VStack w=\"1280\" h=\"720\" padding=\"48\" gap=\"28\" alignItems=\"stretch\" backgroundColor=\"$surface\">\n    <VStack gap=\"8\">\n      <Text fontSize=\"14\" color=\"$accentText\" bold=\"true\" letterSpacing=\"2\">EXECUTIVE SUMMARY</Text>\n      <Text fontSize=\"36\" color=\"$textMain\" bold=\"true\" lineHeight=\"1.15\"><Span color=\"$accent\">ARR</Span> grew to $48.2M while margin softened</Text>\n      <Text fontSize=\"18\" color=\"$textMuted\">Q3 FY26 vs Q2 FY26</Text>\n    </VStack>\n    <VStack gap=\"18\" grow=\"1\">\n      <HStack gap=\"18\" alignItems=\"stretch\" grow=\"1\">\n        <VStack padding=\"24\" gap=\"8\" backgroundColor=\"$accentSoft\" borderRadius=\"16\" border.color=\"$border\" border.width=\"1\" shadow.type=\"outer\" shadow.blur=\"6\" shadow.offset=\"2\" shadow.color=\"000\" justifyContent=\"center\" w=\"49%\">\n          <HStack gap=\"8\" alignItems=\"center\">\n            <Icon name=\"dollar-sign\" size=\"24\" color=\"$accent\"/>\n            <Text fontSize=\"16\" color=\"$accentText\" bold=\"true\" letterSpacing=\"1\">ARR</Text>\n          </HStack>\n          <Text fontSize=\"28\" bold=\"true\" color=\"$accentText\" id=\"kpiv-kpi_metrics-0\">$48.2<Span fontSize=\"14\">M</Span></Text>\n          <Text fontSize=\"16\" bold=\"true\" color=\"$positiveText\">+18% QoQ</Text>\n        </VStack>\n        <VStack padding=\"20\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\" w=\"49%\">\n          <HStack gap=\"8\" alignItems=\"center\">\n            <Icon name=\"percent\" size=\"22\" color=\"$positive\"/>\n            <Text fontSize=\"16\" color=\"$accentText\" bold=\"true\" letterSpacing=\"1\">NRR</Text>\n          </HStack>\n          <Text fontSize=\"28\" bold=\"true\" color=\"$positiveText\" id=\"kpiv-kpi_metrics-1\">114<Span fontSize=\"14\">%</Span></Text>\n          <Text fontSize=\"16\" bold=\"true\" color=\"$positiveText\">+2 pts</Text>\n        </VStack>\n      </HStack>\n      <HStack gap=\"18\" alignItems=\"stretch\" grow=\"1\">\n        <VStack padding=\"20\" gap=\"8\" backgroundColor=\"$negativeSoft\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\" w=\"49%\">\n          <HStack gap=\"8\" alignItems=\"center\">\n            <Icon name=\"trending-down\" size=\"22\" color=\"$negative\"/>\n            <Text fontSize=\"16\" color=\"$accentText\" bold=\"true\" letterSpacing=\"1\">Gross Margin</Text>\n          </HStack>\n          <Text fontSize=\"28\" bold=\"true\" color=\"$negativeText\" id=\"kpiv-kpi_metrics-2\">72.1<Span fontSize=\"14\">%</Span></Text>\n          <Text fontSize=\"16\" bold=\"true\" color=\"$negativeText\">-1.4 pts</Text>\n        </VStack>\n        <VStack padding=\"20\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\" w=\"49%\">\n          <HStack gap=\"8\" alignItems=\"center\">\n            <Icon name=\"clock\" size=\"22\" color=\"$accent\"/>\n            <Text fontSize=\"16\" color=\"$accentText\" bold=\"true\" letterSpacing=\"1\">CAC Payback</Text>\n          </HStack>\n          <Text fontSize=\"28\" bold=\"true\" color=\"$textMain\" id=\"kpiv-kpi_metrics-3\">14<Span fontSize=\"14\"> months</Span></Text>\n          <Text fontSize=\"16\" bold=\"true\" color=\"$positiveText\">-2 months</Text>\n        </VStack>\n      </HStack>\n    </VStack>\n  </VStack>\n</Slide>\n",
 "gate-deck-cheffin-full-s1-r1": "<Slide>\n  <VStack w=\"1280\" h=\"720\" padding=\"48\" gap=\"28\" alignItems=\"stretch\" backgroundColor=\"$surface\">\n    <!-- Header band -->\n    <VStack gap=\"10\">\n      <Text fontSize=\"14\" color=\"$accentText\" bold=\"true\" letterSpacing=\"2\">EXECUTIVE SUMMARY</Text>\n      <Text fontSize=\"36\" color=\"$textMain\" bold=\"true\" lineHeight=\"1.15\">The account is spending at scale, but not yet buying profitable demand.</Text>\n    </VStack>\n    <!-- Combined KPI Scorecard (hero band) -->\n    <HStack gap=\"18\" alignItems=\"stretch\" grow=\"3\">\n      <!-- Combined Spend tile -->\n      <VStack w=\"max\" padding=\"20\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"16\" color=\"$accentText\">Combined spend</Text>\n        <Text fontSize=\"28\" bold=\"true\" id=\"kpiv-combined_kpi_scorecard-0\" color=\"$textMain\">₹114.9<Span fontSize=\"17\">L</Span></Text>\n      </VStack>\n      <!-- Revenue tile -->\n      <VStack w=\"max\" padding=\"20\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"16\" color=\"$accentText\">Combined revenue</Text>\n        <Text fontSize=\"28\" bold=\"true\" id=\"kpiv-combined_kpi_scorecard-1\" color=\"$textMain\">₹37.4<Span fontSize=\"17\">L</Span></Text>\n      </VStack>\n      <!-- Combined ROAS tile (focus, dark/inverted panel) -->\n      <VStack w=\"max\" padding=\"20\" gap=\"8\" backgroundColor=\"$panelDark\" borderRadius=\"14\" justifyContent=\"center\">\n        <Text color=\"$onPanelDark\" fontSize=\"16\">Combined ROAS</Text>\n        <Text color=\"$onPanelDark\" bold=\"true\" fontSize=\"28\" id=\"kpiv-combined_kpi_scorecard-2\">0.33<Span fontSize=\"17\">x</Span></Text>\n      </VStack>\n    </HStack>\n    <!-- Platform ROAS callout (negative, grouped) -->\n    <HStack gap=\"18\" alignItems=\"stretch\" margin.top=\"8\">\n      <VStack w=\"max\" padding=\"16\" gap=\"6\" backgroundColor=\"$negativeSoft\" borderRadius=\"12\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text color=\"$negativeText\" bold=\"true\" fontSize=\"16\">FLIPCART ROAS</Text>\n        <Text color=\"$negativeText\" bold=\"true\" fontSize=\"28\" id=\"kpiv-platform_roas_tiles-0\">0.34<Span fontSize=\"17\">x</Span></Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"16\" gap=\"6\" backgroundColor=\"$negativeSoft\" borderRadius=\"12\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text color=\"$negativeText\" bold=\"true\" fontSize=\"16\">ZAROMA ROAS</Text>\n        <Text color=\"$negativeText\" bold=\"true\" fontSize=\"28\" id=\"kpiv-platform_roas_tiles-1\">0.32<Span fontSize=\"17\">x</Span></Text>\n      </VStack>\n    </HStack>\n    <!-- Insight narrative (supporting, lifted card, highlight key phrase) -->\n    <VStack padding=\"24\" gap=\"10\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" shadow.blur=\"6\" shadow.offset=\"2\" shadow.color=\"000\" margin.top=\"8\">\n      <Text fontSize=\"18\" color=\"$textMain\" lineHeight=\"1.4\">Both FLIPCART and ZAROMA show the same structural issue: CPC is too high relative to AOV and CVR. <Span color=\"$accentText\" bold=\"true\">\"This is a media economics problem, not just a campaign hygiene problem.\"</Span></Text>\n    </VStack>\n  </VStack>\n</Slide>\n",
 "gate-deck-cheffin-full-s1-r2": "<Slide>\n  <VStack w=\"1280\" h=\"720\" padding=\"48\" gap=\"24\" alignItems=\"stretch\" backgroundColor=\"$surface\">\n    <VStack gap=\"10\">\n      <Text fontSize=\"14\" color=\"$accentText\" bold=\"true\" letterSpacing=\"2\">EXECUTIVE SUMMARY</Text>\n      <Text fontSize=\"36\" color=\"$textMain\" bold=\"true\" lineHeight=\"1.15\">The account is spending at scale, but not yet buying profitable demand.</Text>\n    </VStack>\n    <HStack gap=\"18\" alignItems=\"stretch\" grow=\"3\">\n      <VStack w=\"max\" padding=\"20\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"16\" color=\"$accentText\">Combined spend</Text>\n        <Text fontSize=\"28\" bold=\"true\" id=\"kpiv-combined_kpi_scorecard-0\" color=\"$textMain\">₹114.9<Span fontSize=\"17\">L</Span></Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"20\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"16\" color=\"$accentText\">Combined revenue</Text>\n        <Text fontSize=\"28\" bold=\"true\" id=\"kpiv-combined_kpi_scorecard-1\" color=\"$textMain\">₹37.4<Span fontSize=\"17\">L</Span></Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"24\" gap=\"10\" backgroundColor=\"$panelDark\" borderRadius=\"14\" justifyContent=\"center\">\n        <Text color=\"$onPanelDark\" fontSize=\"16\">Combined ROAS</Text>\n        <Text color=\"$onPanelDark\" bold=\"true\" fontSize=\"28\" id=\"kpiv-combined_kpi_scorecard-2\">0.33<Span fontSize=\"17\">x</Span></Text>\n      </VStack>\n    </HStack>\n    <VStack margin.top=\"10\">\n      <HStack gap=\"14\" alignItems=\"stretch\">\n        <VStack w=\"max\" padding=\"16\" gap=\"6\" backgroundColor=\"$negativeSoft\" borderRadius=\"12\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n          <Text color=\"$negativeText\" bold=\"true\" fontSize=\"16\">FLIPCART ROAS</Text>\n          <Text color=\"$negativeText\" bold=\"true\" fontSize=\"28\" id=\"kpiv-platform_roas_tiles-0\">0.34<Span fontSize=\"17\">x</Span></Text>\n        </VStack>\n        <VStack w=\"max\" padding=\"16\" gap=\"6\" backgroundColor=\"$negativeSoft\" borderRadius=\"12\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n          <Text color=\"$negativeText\" bold=\"true\" fontSize=\"16\">ZAROMA ROAS</Text>\n          <Text color=\"$negativeText\" bold=\"true\" fontSize=\"28\" id=\"kpiv-platform_roas_tiles-1\">0.32<Span fontSize=\"17\">x</Span></Text>\n        </VStack>\n      </HStack>\n    </VStack>\n    <VStack padding=\"24\" gap=\"10\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" shadow.blur=\"6\" shadow.offset=\"2\" shadow.color=\"000\" margin.top=\"16\">\n      <Text fontSize=\"18\" color=\"$textMain\" lineHeight=\"1.4\">Both FLIPCART and ZAROMA show the same structural issue: CPC is too high relative to AOV and CVR. <Span color=\"$accentText\" bold=\"true\">\"This is a media economics problem, not just a campaign hygiene problem.\"</Span></Text>\n    </VStack>\n  </VStack>\n</Slide>\n",
 "gate-deck-cheffin-full-s1-r3": "<Slide>\n  <VStack w=\"1280\" h=\"720\" padding=\"48\" gap=\"24\" alignItems=\"stretch\" backgroundColor=\"$surface\">\n    <VStack gap=\"8\">\n      <Text fontSize=\"14\" color=\"$accentText\" bold=\"true\" letterSpacing=\"2\">EXECUTIVE SUMMARY</Text>\n      <Text fontSize=\"36\" color=\"$textMain\" bold=\"true\" lineHeight=\"1.15\">The account is spending at scale, but not yet buying profitable demand.</Text>\n    </VStack>\n    <HStack gap=\"18\" alignItems=\"stretch\" grow=\"3\">\n      <VStack w=\"max\" padding=\"20\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"16\" color=\"$accentText\">Combined spend</Text>\n        <Text fontSize=\"28\" bold=\"true\" id=\"kpiv-combined_kpi_scorecard-0\" color=\"$textMain\">₹114.9<Span fontSize=\"17\">L</Span></Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"20\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"16\" color=\"$accentText\">Combined revenue</Text>\n        <Text fontSize=\"28\" bold=\"true\" id=\"kpiv-combined_kpi_scorecard-1\" color=\"$textMain\">₹37.4<Span fontSize=\"17\">L</Span></Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"24\" gap=\"10\" backgroundColor=\"$panelDark\" borderRadius=\"14\" justifyContent=\"center\">\n        <Text color=\"$onPanelDark\" fontSize=\"16\">Combined ROAS</Text>\n        <Text color=\"$onPanelDark\" bold=\"true\" fontSize=\"28\" id=\"kpiv-combined_kpi_scorecard-2\">0.33<Span fontSize=\"17\">x</Span></Text>\n      </VStack>\n    </HStack>\n    <VStack>\n      <HStack gap=\"16\" alignItems=\"stretch\">\n        <VStack w=\"max\" padding=\"16\" gap=\"6\" backgroundColor=\"$negativeSoft\" borderRadius=\"12\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n          <Text color=\"$negativeText\" bold=\"true\" fontSize=\"16\">FLIPCART ROAS</Text>\n          <Text color=\"$negativeText\" bold=\"true\" fontSize=\"28\" id=\"kpiv-platform_roas_tiles-0\">0.34<Span fontSize=\"17\">x</Span></Text>\n        </VStack>\n        <VStack w=\"max\" padding=\"16\" gap=\"6\" backgroundColor=\"$negativeSoft\" borderRadius=\"12\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n          <Text color=\"$negativeText\" bold=\"true\" fontSize=\"16\">ZAROMA ROAS</Text>\n          <Text color=\"$negativeText\" bold=\"true\" fontSize=\"28\" id=\"kpiv-platform_roas_tiles-1\">0.32<Span fontSize=\"17\">x</Span></Text>\n        </VStack>\n      </HStack>\n    </VStack>\n    <VStack padding=\"24\" gap=\"10\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" shadow.blur=\"6\" shadow.offset=\"2\" shadow.color=\"000\">\n      <Text fontSize=\"16\" color=\"$textMain\" lineHeight=\"1.4\">Both FLIPCART and ZAROMA show the same structural issue: CPC is too high relative to AOV and CVR. <Span color=\"$accentText\" bold=\"true\">\"This is a media economics problem, not just a campaign hygiene problem.\"</Span></Text>\n    </VStack>\n  </VStack>\n</Slide>\n",
 "gate-deck-cheffin-full-s4-r1": "<Slide>\n  <VStack w=\"1280\" h=\"720\" padding=\"48\" gap=\"28\" alignItems=\"stretch\" backgroundColor=\"$surface\">\n    <VStack gap=\"8\">\n      <Text fontSize=\"14\" color=\"$accentText\" bold=\"true\" letterSpacing=\"2\">FLIPCART SNAPSHOT</Text>\n      <Text fontSize=\"36\" color=\"$textMain\" bold=\"true\" lineHeight=\"1.15\">FLIPCART is generating traffic, but at <Span color=\"$accentText\" bold=\"true\">weak revenue efficiency</Span>.</Text>\n    </VStack>\n    <HStack gap=\"18\" alignItems=\"stretch\" grow=\"1\">\n      <VStack w=\"max\" padding=\"18\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"16\" color=\"$textMuted\">Spend</Text>\n        <Text fontSize=\"28\" bold=\"true\" color=\"$textMain\" id=\"kpiv-flipkart_kpis-0\">₹29.4<Span fontSize=\"17\">L</Span></Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"18\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"16\" color=\"$textMuted\">Ad sales</Text>\n        <Text fontSize=\"28\" bold=\"true\" color=\"$textMain\" id=\"kpiv-flipkart_kpis-1\">₹10.1<Span fontSize=\"17\">L</Span></Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"18\" gap=\"8\" backgroundColor=\"$surfaceAlt\" borderRadius=\"14\" border.color=\"$border\" border.width=\"1\" justifyContent=\"center\">\n        <Text fontSize=\"16\" color=\"$textMuted\">ROAS</Text>\n        <Text fontSize=\"28\" bold=\"true\" color=\"$textMain\" id=\"kpiv-flipkart_kpis-2\">0.34<Span fontSize=\"17\">x</Span></Text>\n      </VStack>\n      <VStack w=\"max\" padding=\"18\" gap=\"8\" backgroundColor=\"$warningSoft\" borderRadius=\"14\" border.color=\"$warning\" border.width=\"2\" justifyContent=\"center\">\n        <Text fontSize=\"16\" color=\"$warningText\" bold=\"true\">CPC</Text>\n       