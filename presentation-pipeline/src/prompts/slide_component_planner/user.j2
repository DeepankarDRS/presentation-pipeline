<deck>
Core hook: {{ core_hook }}
Other slides in deck: {{ deck_context | join(' | ') }}
{% if deck_settings %}
Content level: {{ constraints.get('content_level', 'normal') }}
Text mode: {{ deck_settings.get('text_mode', 'generate') }}
Write for: {{ deck_settings.get('write_for') | join(', ') or 'general' }}
Tone: {{ deck_settings.get('tone') | join(', ') or 'professional' }}
{% endif %}
</deck>

<slide number="{{ slide.slide_index + 1 }}" of="{{ total_slides }}">
{% if slide.label %}
Label (kicker): {{ slide.label }}
{% endif %}
Headline: {{ slide.slide_title }}
{% if slide.subtitle %}
Subtitle: {{ slide.subtitle }}
{% endif %}
Section: {{ slide.section or '(none)' }}
Narrative role: {{ slide.narrative_role }}

<key_messages>
{% for msg in content_messages %}
{{ loop.index }}. {{ msg }}
{% endfor %}
</key_messages>

<visual_direction>
Visual direction from the brief (how to draw this slide, never text on it):
{% for d in visual_directions %}
- {{ d }}
{% else %}
(none: choose from the shape of the key messages and the headline)
{% endfor %}
</visual_direction>
{% if supplied_content_for_slide %}

<supplied_content>
Supplied content for this slide, to copy into {{ content_field }} as given:
```json
{{ supplied_content_for_slide | tojson(indent=2) }}
```
</supplied_content>
{% endif %}
</slide>

Plan this one slide.
{% if repair_context %}

<repair>
REPAIR CONTEXT: the previous plan for this slide had these problems; fix them:
Failed components: {{ repair_context.failed_kinds | join(', ') }}
{% for err in repair_context.errors[:5] %}
- {{ err }}
{% endfor %}
{{ repair_context.directive }}
{% if repair_context.previous_plan %}
<previous_plan>
{{ repair_context.previous_plan }}
</previous_plan>
{% endif %}
</repair>
{% endif %}
