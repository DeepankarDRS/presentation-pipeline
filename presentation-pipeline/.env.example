# Required
OPENAI_API_KEY=sk-...

# Optional: override model per step (defaults come from models.yaml)
# OPENAI_MODEL=gpt-4.1-mini

# Optional: Azure OpenAI (set provider to azure_openai in models.yaml)
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=...

# Optional: slide component planner (src/agents/slide_component_planner.py)
# SLIDE_PLANNER_SERIALIZE=true    # plan slides one at a time (default: false, in parallel)
# SLIDE_PLANNER_MAX_PARALLEL=6    # parallel planner calls when not serialized (default: 6)
# PLANNER_SCHEMA=string           # old planner output (content as a JSON string); default: typed

# Optional: KPI / card drawing and composition nodes (read at call time; eval scripts set their own per arm)
# POM_BLOCKS=kpi                  # kpi (default: KPI text by element refs) | tiles (code draws KPI tiles + cards) | off
# POM_NODES=                      # comma list code draws: chart, timeline, process_arrow, flow, kpi_row, card_grid (kpi_row needs POM_BLOCKS kpi or tiles)

# Optional: LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=presentation-pipeline

# Node.js binary for POM compiler
# NODE_BIN=node
